# .editorconfig
# PLACEHOLDER - implemented by T-001 (docs/DEVELOPMENT_GUIDE.md). Replace this header with the script.
# Purpose: Formatting rules shared by every editor.
# Steps:
#   1. root = true; [*] indent_style = space, indent_size = 4, end_of_line = lf, charset = utf-8, insert_final_newline = true
#   2. [*.cs] dotnet_diagnostic.IDE0005.severity = warning (unused usings)
#   3. [*.{sh,Dockerfile}] end_of_line = lf
