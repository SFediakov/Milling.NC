<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miller.App.ViewModels"
             xmlns:c="using:Miller.App.Controls"
             x:Class="Miller.App.Views.CuttingParametersView"
             x:DataType="vm:CuttingParametersViewModel">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
      <TextBlock Classes="header" Text="Speeds" />
      <TextBlock Classes="label" Text="Feed rate (mm/min)" />
      <c:NumericBox Name="FeedRateBox" Classes="numeric" Value="{Binding FeedRate}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding FeedRateError}" IsVisible="{Binding FeedRateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Plunge rate (mm/min)" />
      <c:NumericBox Name="PlungeRateBox" Classes="numeric" Value="{Binding PlungeRate}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding PlungeRateError}" IsVisible="{Binding PlungeRateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Rapid rate (mm/min)" />
      <c:NumericBox Name="RapidRateBox" Classes="numeric" Value="{Binding RapidRate}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding RapidRateError}" IsVisible="{Binding RapidRateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Spindle speed (rpm)" />
      <c:NumericBox Name="SpindleRpmBox" Classes="numeric" Value="{Binding SpindleRpm}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding SpindleRpmError}" IsVisible="{Binding SpindleRpmError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Classes="header" Text="Clearances" />
      <TextBlock Classes="label" Text="Stepover of Z layer by layer (mm)" />
      <c:NumericBox Name="StepoverBox" Classes="numeric" Value="{Binding Stepover}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding StepoverError}" IsVisible="{Binding StepoverError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Stepover of 3 axis freedom (mm)" />
      <c:NumericBox Name="FinishingStepoverBox" Classes="numeric" Value="{Binding FinishingStepover}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding FinishingStepoverError}" IsVisible="{Binding FinishingStepoverError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Stepdown per level (mm)" />
      <c:NumericBox Name="StepdownBox" Classes="numeric" Value="{Binding Stepdown}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding StepdownError}" IsVisible="{Binding StepdownError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Safe height above the stock top (mm)" />
      <c:NumericBox Name="SafeHeightBox" Classes="numeric" Value="{Binding SafeHeight}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding SafeHeightError}" IsVisible="{Binding SafeHeightError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Classes="header" Text="Resolution" />
      <TextBlock Classes="label" Text="Cell size (mm)" />
      <c:NumericBox Name="CellSizeBox" Classes="numeric" Value="{Binding CellSize}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding CellSizeError}" IsVisible="{Binding CellSizeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="warning" Text="{Binding CellSizeWarning}" IsVisible="{Binding CellSizeWarning, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
      <TextBlock Name="GridSizeText" Text="{Binding GridSizeText}" TextWrapping="Wrap" />
      <TextBlock Classes="label" Text="Tolerance (mm)" />
      <c:NumericBox Name="ToleranceBox" Classes="numeric" Value="{Binding Tolerance}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
