<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miller.App.ViewModels"
             xmlns:c="using:Miller.App.Controls"
             xmlns:m="using:Miller.Application.Macros"
             x:Class="Miller.App.Views.MachineView"
             x:DataType="vm:MachineViewModel">
  <!-- Connection, work coordinates, program and macros are open; jog, overrides and console stay
       folded until needed. Every display text is a SelectableTextBlock so it can be selected and copied. -->
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
      <SelectableTextBlock Classes="header" Text="Machine" />
      <SelectableTextBlock Name="StateText" Classes="machine-state" Text="{Binding StateText}" />
      <SelectableTextBlock Name="ConnectionText" Text="{Binding ConnectionText}" TextWrapping="Wrap" />
      <SelectableTextBlock Name="MessageText" Classes="warning" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />

      <Expander Name="ConnectionSection" Header="Connection" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <ComboBox Name="ConnectionKindBox" ItemsSource="{x:Static vm:MachineViewModel.ConnectionKinds}" SelectedIndex="{Binding ConnectionIndex}" Width="160" />
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4" IsVisible="{Binding IsSerial}">
            <SelectableTextBlock Classes="label" Text="Port" />
            <ComboBox Grid.Column="1" Name="PortBox" IsEditable="True" ItemsSource="{Binding Ports}" Text="{Binding SerialPort}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Name="RefreshPortsButton" Content="Refresh" Command="{Binding RefreshPortsCommand}" />
            <SelectableTextBlock Grid.Row="1" Classes="label" Text="Baud" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="BaudBox" ItemsSource="{x:Static vm:MachineViewModel.BaudRates}" SelectedItem="{Binding BaudRate}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4" IsVisible="{Binding IsNetwork}">
            <SelectableTextBlock Classes="label" Text="Host" />
            <TextBox Grid.Column="1" Name="HostBox" Text="{Binding Host}" />
            <SelectableTextBlock Grid.Row="1" Classes="label" Text="Port" />
            <c:NumericBox Grid.Row="1" Grid.Column="1" Name="NetworkPortBox" Classes="numeric" Value="{Binding NetworkPort}" HorizontalAlignment="Left" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="ConnectButton" Content="Connect" Command="{Binding ConnectCommand}" />
            <Button Name="DisconnectButton" Content="Disconnect" Command="{Binding DisconnectCommand}" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Grid Name="PositionGrid" ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="2" Margin="0,4,0,0">
        <SelectableTextBlock Grid.Column="1" Classes="label" Text="X" />
        <SelectableTextBlock Grid.Column="2" Classes="label" Text="Y" />
        <SelectableTextBlock Grid.Column="3" Classes="label" Text="Z" />
        <SelectableTextBlock Grid.Row="1" Classes="label" Text="Work" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Name="WorkXText" Classes="position" Text="{Binding WorkX}" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="2" Name="WorkYText" Classes="position" Text="{Binding WorkY}" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="3" Name="WorkZText" Classes="position" Text="{Binding WorkZ}" />
        <SelectableTextBlock Grid.Row="2" Classes="label" Text="Machine" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Name="MachineXText" Text="{Binding MachineX}" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="2" Name="MachineYText" Text="{Binding MachineY}" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="3" Name="MachineZText" Text="{Binding MachineZ}" />
        <SelectableTextBlock Grid.Row="3" Classes="label" Text="Feed" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Name="FeedSpindleText">
          <Run Text="{Binding FeedText}" />
          <Run Text="  " />
          <Run Text="{Binding SpindleText}" />
        </SelectableTextBlock>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="HomeButton" Content="Home" Command="{Binding HomeCommand}" />
        <Button Name="UnlockButton" Content="Unlock" Command="{Binding UnlockCommand}" />
        <Button Name="ResetButton" Content="Reset" Command="{Binding ResetCommand}" />
      </StackPanel>

      <Expander Name="WorkSection" Header="Work coordinates" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <Grid Name="WorkGrid" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
            <SelectableTextBlock Classes="label" Text="X" />
            <c:NumericBox Grid.Column="1" Name="WorkValueXBox" Classes="numeric" Value="{Binding WorkValueX}" />
            <Button Grid.Column="2" Name="SetWorkXButton" Content="Set X" Command="{Binding SetWorkCommand}" CommandParameter="X" />
            <SelectableTextBlock Grid.Row="1" Classes="label" Text="Y" />
            <c:NumericBox Grid.Row="1" Grid.Column="1" Name="WorkValueYBox" Classes="numeric" Value="{Binding WorkValueY}" />
            <Button Grid.Row="1" Grid.Column="2" Name="SetWorkYButton" Content="Set Y" Command="{Binding SetWorkCommand}" CommandParameter="Y" />
            <SelectableTextBlock Grid.Row="2" Classes="label" Text="Z" />
            <c:NumericBox Grid.Row="2" Grid.Column="1" Name="WorkValueZBox" Classes="numeric" Value="{Binding WorkValueZ}" />
            <Button Grid.Row="2" Grid.Column="2" Name="SetWorkZButton" Content="Set Z" Command="{Binding SetWorkCommand}" CommandParameter="Z" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="SetWorkAllButton" Content="Set all" Command="{Binding SetWorkCommand}" CommandParameter="XYZ" />
            <Button Name="ReadWorkButton" Content="From position" Command="{Binding ReadWorkCommand}" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Name="ProgramSection" Header="Program" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <SelectableTextBlock Name="ProgramText" Text="{Binding ProgramText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="UseToolpathButton" Content="Use toolpath" Command="{Binding UseToolpathCommand}" />
            <Button Name="OpenFileButton" Content="Open file" Command="{Binding OpenFileCommand}" />
          </StackPanel>
          <Button Name="ShowListingButton" Content="Code" Command="{Binding ShowListingCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="StartButton" Content="Start" Command="{Binding StartCommand}" />
            <Button Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}" />
            <Button Name="ResumeButton" Content="Resume" Command="{Binding ResumeCommand}" />
            <Button Name="StopButton" Content="Stop" Command="{Binding StopCommand}" />
          </StackPanel>
          <Button Name="SaveProgressButton" Content="Save progress" Command="{Binding SaveProgressCommand}" />
          <ProgressBar Name="JobProgress" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="14" />
          <SelectableTextBlock Name="ProgressText" Text="{Binding ProgressText}" TextWrapping="Wrap" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock Name="TimeText" Text="{Binding TimeText}" IsVisible="{Binding TimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock Name="JobText" Text="{Binding JobText}" TextWrapping="Wrap" Classes.warning="{Binding JobFailed}" IsVisible="{Binding JobText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Expander>

      <Expander Name="MacrosSection" Header="Macros" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <ItemsControl Name="MacroButtons" ItemsSource="{Binding Macros}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:MachineMacro">
                <Button Content="{Binding Name}" Margin="0,0,6,6"
                        Command="{Binding $parent[ItemsControl].((vm:MachineViewModel)DataContext).RunMacroCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Name="MacroEditor" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
            <SelectableTextBlock Classes="label" Text="Edit" />
            <ComboBox Grid.Column="1" Name="MacroBox" ItemsSource="{Binding MacroNames}" SelectedIndex="{Binding MacroIndex}" HorizontalAlignment="Stretch" />
            <SelectableTextBlock Grid.Row="1" Classes="label" Text="Name" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="MacroNameBox" Text="{Binding MacroName}" />
            <SelectableTextBlock Grid.Row="2" Classes="label" Text="Delay (ms)" />
            <c:NumericBox Grid.Row="2" Grid.Column="1" Name="MacroDelayBox" Classes="numeric" Value="{Binding MacroDelay}" HorizontalAlignment="Left" />
            <SelectableTextBlock Grid.Row="3" Classes="label" Text="Commands" VerticalAlignment="Top" />
            <TextBox Grid.Row="3" Grid.Column="1" Name="MacroTextBox" Text="{Binding MacroText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="96" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="NewMacroButton" Content="New" Command="{Binding NewMacroCommand}" />
            <Button Name="SaveMacroButton" Content="Save" Command="{Binding SaveMacroCommand}" />
            <Button Name="DeleteMacroButton" Content="Delete" Command="{Binding DeleteMacroCommand}" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Name="JogSection" Header="Jog and zero" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <SelectableTextBlock Classes="label" Text="Step" />
            <ComboBox Grid.Column="1" Name="JogStepBox" ItemsSource="{x:Static vm:MachineViewModel.JogSteps}" SelectedItem="{Binding JogStep}" MinWidth="80" />
            <SelectableTextBlock Grid.Column="2" Classes="label" Text="Feed" />
            <c:NumericBox Grid.Column="3" Name="JogFeedBox" Classes="numeric" Value="{Binding JogFeed}" />
          </Grid>
          <Grid Name="JogPad" Classes="jog" ColumnDefinitions="52,52,52,16,52" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="4">
            <Button Grid.Column="1" Name="JogYPlusButton" Content="Y+" Command="{Binding JogCommand}" CommandParameter="Y+" HorizontalAlignment="Stretch" />
            <Button Grid.Row="1" Name="JogXMinusButton" Content="X-" Command="{Binding JogCommand}" CommandParameter="X-" HorizontalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="2" Name="JogXPlusButton" Content="X+" Command="{Binding JogCommand}" CommandParameter="X+" HorizontalAlignment="Stretch" />
            <Button Grid.Row="2" Grid.Column="1" Name="JogYMinusButton" Content="Y-" Command="{Binding JogCommand}" CommandParameter="Y-" HorizontalAlignment="Stretch" />
            <Button Grid.Column="4" Name="JogZPlusButton" Content="Z+" Command="{Binding JogCommand}" CommandParameter="Z+" HorizontalAlignment="Stretch" />
            <Button Grid.Row="2" Grid.Column="4" Name="JogZMinusButton" Content="Z-" Command="{Binding JogCommand}" CommandParameter="Z-" HorizontalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="4" Name="CancelJogButton" Content="Halt" Command="{Binding CancelJogCommand}" HorizontalAlignment="Stretch" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <SelectableTextBlock Classes="label" Text="Zero" />
            <Button Name="ZeroXButton" Content="X" Command="{Binding ZeroCommand}" CommandParameter="X" />
            <Button Name="ZeroYButton" Content="Y" Command="{Binding ZeroCommand}" CommandParameter="Y" />
            <Button Name="ZeroZButton" Content="Z" Command="{Binding ZeroCommand}" CommandParameter="Z" />
            <Button Name="ZeroAllButton" Content="All" Command="{Binding ZeroCommand}" CommandParameter="XYZ" />
          </StackPanel>
          <Button Name="GoToZeroButton" Content="Go to XY zero" Command="{Binding GoToZeroCommand}" />
          <SelectableTextBlock Classes="label" Text="Probe Z with a touch plate (mm, mm/min)" />
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
            <SelectableTextBlock Classes="label" Text="Plate" />
            <c:NumericBox Grid.Column="1" Name="ProbeThicknessBox" Classes="numeric" Value="{Binding ProbeThickness}" />
            <SelectableTextBlock Grid.Column="2" Classes="label" Text="Travel" />
            <c:NumericBox Grid.Column="3" Name="ProbeTravelBox" Classes="numeric" Value="{Binding ProbeTravel}" />
            <SelectableTextBlock Grid.Row="1" Classes="label" Text="Feed" />
            <c:NumericBox Grid.Row="1" Grid.Column="1" Name="ProbeFeedBox" Classes="numeric" Value="{Binding ProbeFeed}" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="Lift" />
            <c:NumericBox Grid.Row="1" Grid.Column="3" Name="ProbeRetractBox" Classes="numeric" Value="{Binding ProbeRetract}" />
          </Grid>
          <Button Name="ProbeButton" Content="Probe Z" Command="{Binding ProbeCommand}" />
        </StackPanel>
      </Expander>

      <Expander Name="OverridesSection" Header="Overrides" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
          <SelectableTextBlock Classes="label" Text="Feed" />
          <Button Grid.Column="1" Content="-10" Command="{Binding OverrideCommand}" CommandParameter="F-" />
          <Button Grid.Column="2" Content="100%" Command="{Binding OverrideCommand}" CommandParameter="F0" />
          <Button Grid.Column="3" Content="+10" Command="{Binding OverrideCommand}" CommandParameter="F+" />
          <SelectableTextBlock Grid.Column="4" Name="FeedOverrideText" Text="{Binding FeedOverrideText}" VerticalAlignment="Center" />
          <SelectableTextBlock Grid.Row="1" Classes="label" Text="Rapid" />
          <Button Grid.Row="1" Grid.Column="1" Content="25%" Command="{Binding OverrideCommand}" CommandParameter="R25" />
          <Button Grid.Row="1" Grid.Column="2" Content="50%" Command="{Binding OverrideCommand}" CommandParameter="R50" />
          <Button Grid.Row="1" Grid.Column="3" Content="100%" Command="{Binding OverrideCommand}" CommandParameter="R100" />
          <SelectableTextBlock Grid.Row="1" Grid.Column="4" Name="RapidOverrideText" Text="{Binding RapidOverrideText}" VerticalAlignment="Center" />
          <SelectableTextBlock Grid.Row="2" Classes="label" Text="Spindle" />
          <Button Grid.Row="2" Grid.Column="1" Content="-10" Command="{Binding OverrideCommand}" CommandParameter="S-" />
          <Button Grid.Row="2" Grid.Column="2" Content="100%" Command="{Binding OverrideCommand}" CommandParameter="S0" />
          <Button Grid.Row="2" Grid.Column="3" Content="+10" Command="{Binding OverrideCommand}" CommandParameter="S+" />
          <SelectableTextBlock Grid.Row="2" Grid.Column="4" Name="SpindleOverrideText" Text="{Binding SpindleOverrideText}" VerticalAlignment="Center" />
        </Grid>
      </Expander>

      <Expander Name="ConsoleSection" Header="Console" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <ListBox Name="ConsoleList" ItemsSource="{Binding ConsoleLines}" Height="180" Classes="console">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Name="ConsoleInputBox" Text="{Binding ConsoleInput}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Name="SendButton" Content="Send" Command="{Binding SendCommand}" />
          </Grid>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
