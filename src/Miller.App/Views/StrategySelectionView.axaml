<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miller.App.ViewModels"
             xmlns:c="using:Miller.App.Controls"
             xmlns:tp="using:Miller.Core.Toolpaths"
             xmlns:gc="using:Miller.Core.GCode"
             x:Class="Miller.App.Views.StrategySelectionView"
             x:DataType="vm:StrategySelectionViewModel">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
      <TextBlock Classes="header" Text="Strategy" />

      <TextBlock Classes="label" Text="Routing strategy" />
      <ComboBox Name="StrategyBox" ItemsSource="{x:Static vm:StrategySelectionViewModel.Strategies}" SelectedItem="{Binding Strategy}" Width="260" HorizontalAlignment="Left">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="tp:IToolpathStrategy">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="label" Text="Cut scope" />
      <ComboBox Name="CutScopeBox" ItemsSource="{x:Static vm:StrategySelectionViewModel.CutScopes}" SelectedItem="{Binding CutScope}" Width="260" HorizontalAlignment="Left" />
      <TextBlock Classes="label" Text="Material islands: keep islands of at least (mm3)" />
      <c:NumericBox Name="MinIslandVolumeBox" Classes="numeric" Value="{Binding MinIslandVolume}" IsEnabled="{Binding IsSeparation}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding MinIslandVolumeError}" IsVisible="{Binding MinIslandVolumeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Holding bridges per freed part (0: none)" />
      <c:NumericBox Name="BridgeCountBox" Classes="numeric" Value="{Binding BridgeCount}" IsEnabled="{Binding IsSeparation}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding BridgeCountError}" IsVisible="{Binding BridgeCountError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="Bridge width (mm)" />
      <c:NumericBox Name="BridgeWidthBox" Classes="numeric" Value="{Binding BridgeWidth}" IsEnabled="{Binding IsSeparation}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding BridgeWidthError}" IsVisible="{Binding BridgeWidthError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="warning" Text="{Binding BridgeWidthWarning}" IsVisible="{Binding BridgeWidthWarning, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
      <TextBlock Classes="label" Text="Bridge height above the cut bottom (mm)" />
      <c:NumericBox Name="BridgeHeightBox" Classes="numeric" Value="{Binding BridgeHeight}" IsEnabled="{Binding IsSeparation}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding BridgeHeightError}" IsVisible="{Binding BridgeHeightError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Classes="label" Text="Reach rule: free footprint cells needed (%)" />
      <c:NumericBox Name="ReachPercentBox" Classes="numeric" Value="{Binding ReachPercent}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding ReachPercentError}" IsVisible="{Binding ReachPercentError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Classes="label" Text="Collision handling" />
      <ComboBox Name="CollisionModeBox" ItemsSource="{x:Static vm:StrategySelectionViewModel.CollisionModes}" SelectedItem="{Binding CollisionMode}" Width="260" HorizontalAlignment="Left" />
      <TextBlock Classes="label" Text="Recursion: finished model cells per damaged cell to keep a position (X)" TextWrapping="Wrap" />
      <c:NumericBox Name="RecursionRatioBox" Classes="numeric" Value="{Binding RecursionRatio}" IsEnabled="{Binding IsRecursion}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding RecursionRatioError}" IsVisible="{Binding RecursionRatioError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="label" Text="One run: finished model cells per damaged cell to keep a node (Y)" TextWrapping="Wrap" />
      <c:NumericBox Name="OneRunRatioBox" Classes="numeric" Value="{Binding OneRunRatio}" IsEnabled="{Binding IsOneRun}" HorizontalAlignment="Left" />
      <TextBlock Classes="validation" Text="{Binding OneRunRatioError}" IsVisible="{Binding OneRunRatioError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Classes="label" Text="Post-processor" />
      <ComboBox Name="PostProcessorBox" ItemsSource="{Binding PostProcessors}" SelectedItem="{Binding PostProcessor}" Width="260" HorizontalAlignment="Left">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="gc:IPostProcessor">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button Name="GenerateButton" Content="Generate toolpath" Command="{Binding GenerateCommand}" />
        <Button Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>

      <TextBlock Classes="header" Text="Statistics" />
      <TextBlock Name="StatisticsText" Text="{Binding StatisticsText}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
