<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miller.App.ViewModels"
             x:Class="Miller.App.Views.MainMenu"
             x:DataType="vm:MainWindowViewModel">
  <Menu Name="Menu">
    <MenuItem Header="_File" Name="FileMenu">
      <MenuItem Header="Open _STL..." Name="OpenStlItem" Command="{Binding OpenStlCommand}" InputGesture="Ctrl+O" />
      <MenuItem Header="_Open Project..." Name="OpenProjectItem" Command="{Binding OpenProjectCommand}" />
      <MenuItem Header="_Save Project" Name="SaveProjectItem" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S" />
      <MenuItem Header="Save Project _As..." Name="SaveProjectAsItem" Command="{Binding SaveProjectAsCommand}" />
      <Separator />
      <MenuItem Header="_Export NC..." Name="ExportNcItem" Command="{Binding ExportNcCommand}" InputGesture="Ctrl+E" />
      <Separator />
      <MenuItem Header="E_xit" Name="ExitItem" Command="{Binding ExitCommand}" />
    </MenuItem>
    <MenuItem Header="_Toolpath" Name="ToolpathMenu">
      <MenuItem Header="_Generate" Name="GenerateItem" Command="{Binding GenerateCommand}" InputGesture="F5" />
      <MenuItem Header="_Cancel" Name="CancelGenerateItem" Command="{Binding CancelGenerateCommand}" />
    </MenuItem>
    <MenuItem Header="_View" Name="ViewMenu">
      <MenuItem Header="_Reset Camera" Name="ResetCameraItem" Command="{Binding ResetCameraCommand}" InputGesture="Ctrl+D0" />
      <Separator />
      <!-- A click on a check item toggles IsChecked itself before the click is raised, so these
           items carry no command; the window key bindings hold the toggle commands. -->
      <MenuItem Header="Show _Model" Name="ShowModelItem" ToggleType="CheckBox" IsChecked="{Binding Viewport.ShowModel, Mode=TwoWay}" InputGesture="Ctrl+D1" />
      <MenuItem Header="Show _Stock" Name="ShowStockItem" ToggleType="CheckBox" IsChecked="{Binding Viewport.ShowStock, Mode=TwoWay}" InputGesture="Ctrl+D2" />
      <MenuItem Header="Show _Toolpath" Name="ShowToolpathItem" ToggleType="CheckBox" IsChecked="{Binding Viewport.ShowToolpath, Mode=TwoWay}" InputGesture="Ctrl+D3" />
      <MenuItem Header="Show Too_l" Name="ShowToolItem" ToggleType="CheckBox" IsChecked="{Binding Viewport.ShowTool, Mode=TwoWay}" InputGesture="Ctrl+D4" />
    </MenuItem>
    <MenuItem Header="_Simulation" Name="SimulationMenu">
      <MenuItem Header="_Play" Name="PlayItem" Command="{Binding SimulationPanel.PlayCommand}" />
      <MenuItem Header="P_ause" Name="PauseItem" Command="{Binding SimulationPanel.PauseCommand}" />
      <MenuItem Header="_Stop" Name="StopItem" Command="{Binding SimulationPanel.StopCommand}" />
      <MenuItem Header="_Run To End" Name="RunToEndItem" Command="{Binding SimulationPanel.RunToEndCommand}" />
    </MenuItem>
    <MenuItem Header="_Help" Name="HelpMenu">
      <MenuItem Header="_About" Name="AboutItem" Command="{Binding ShowAboutCommand}" />
    </MenuItem>
  </Menu>
</UserControl>
