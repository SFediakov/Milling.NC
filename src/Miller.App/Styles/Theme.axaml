<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Speed legend (T-224): one row per label; the bar is inset by half a row at both ends, so its ends
       meet the centres of the first and the last label. -->
  <Styles.Resources>
    <x:Double x:Key="LegendRowHeight">18</x:Double>
    <Thickness x:Key="LegendBarMargin">0,9,6,9</Thickness>
    <x:Double x:Key="LegendBarWidth">12</x:Double>
    <x:Double x:Key="LegendFontSize">12</x:Double>
  </Styles.Resources>
  <!-- Every color here comes from Colors.axaml. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="TextBlock.header, SelectableTextBlock.header">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.label, SelectableTextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBox.numeric">
    <Setter Property="Width" Value="96" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.validation">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.machine-state, SelectableTextBlock.machine-state">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.position, SelectableTextBlock.position">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Grid.jog Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.console">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ListBox.console ListBoxItem">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.row.executed">
    <Setter Property="Background" Value="{DynamicResource ListingExecutedBrush}" />
  </Style>
  <Style Selector="Border.row.executing">
    <Setter Property="Background" Value="{DynamicResource ListingExecutingBrush}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.legend">
    <Setter Property="Background" Value="{DynamicResource LegendBackgroundBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TextBlock.legend-title">
    <Setter Property="FontSize" Value="{StaticResource LegendFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Panel.legend-row">
    <Setter Property="Height" Value="{StaticResource LegendRowHeight}" />
  </Style>
  <Style Selector="TextBlock.legend-value">
    <Setter Property="FontSize" Value="{StaticResource LegendFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.legend-bar">
    <Setter Property="Width" Value="{StaticResource LegendBarWidth}" />
    <Setter Property="Margin" Value="{StaticResource LegendBarMargin}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.legend-swatch">
    <Setter Property="Width" Value="{StaticResource LegendBarWidth}" />
    <Setter Property="Height" Value="{StaticResource LegendBarWidth}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
