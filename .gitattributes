* text=auto
# Hook scripts run under bash; a CRLF checkout (core.autocrlf=true on Windows) breaks every guard and fails the session closed.
*.sh text eol=lf
# STL may be binary; never apply line-ending conversion.
*.STL binary
*.stl binary
# Vendored NuGet packages are binary archives.
*.nupkg binary
# Golden G-code files are compared byte for byte; keep LF.
*.nc text eol=lf
# Dockerfile and editorconfig are parsed line by line; keep LF in the working copy on Windows.
Dockerfile text eol=lf
.editorconfig text eol=lf
# Vendored Debian packages are binary archives.
*.deb binary
