<Project>
  <PropertyGroup>
    <!-- Every documented command (build.sh, dotnet test Miller.sln) builds Release; without this
         default a plain dotnet build/test creates a second Debug output tree of the same size. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- The runtimes the project supports (same list as RIDS in build.sh and scripts/vendor-packages.sh). -->
    <MillerRuntimeIdentifiers>win-x64;linux-x64</MillerRuntimeIdentifiers>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship native libraries for 17 runtimes plus 300 MB of native .pdb
       symbols; the SDK copies all of them into every bin/ and publish folder. Keep only the
       libraries of the supported runtimes and no native symbols. -->
  <Target Name="TrimPackageNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems>
        <MillerSupportedRuntime>$([System.String]::Copy(';$(MillerRuntimeIdentifiers);').Contains(';%(RuntimeIdentifier);'))</MillerSupportedRuntime>
      </RuntimeTargetsCopyLocalItems>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(MillerSupportedRuntime)' != 'True'" />
    </ItemGroup>
  </Target>
</Project>
